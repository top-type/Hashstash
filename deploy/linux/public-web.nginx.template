# Replace PUBLIC_IP with this server's IPv4 address. This proxy deliberately
# has no route to the private wallet/admin RPC port.
limit_req_zone $binary_remote_addr zone=hashstash_web:10m rate=15r/s;
limit_conn_zone $binary_remote_addr zone=hashstash_connections:10m;

server {
    listen 80 default_server;
    server_name PUBLIC_IP;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/hashstash-acme;
        try_files $uri =404;
    }
    location / { return 308 https://PUBLIC_IP$request_uri; }
}

server {
    listen 443 ssl default_server;
    server_name PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/PUBLIC_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PUBLIC_IP/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:HashstashTLS:10m;
    ssl_session_timeout 1h;
    server_tokens off;
    if ($host != PUBLIC_IP) { return 421; }
    # Hex-encoded maximum block record plus JSON framing; the node enforces
    # the current, usually much smaller, governed transaction capacity.
    client_max_body_size 65m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 15s;
    limit_conn hashstash_connections 20;
    limit_req zone=hashstash_web burst=60 nodelay;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    location / {
        proxy_pass http://127.0.0.1:18483;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_send_timeout 10s;
    }
}

# Plain KEY=value data: no quotes, interpolation, or inline comments.
# Replace with this node's payout PUBLIC key. Keep its private key offline.
MINER_PUBLIC_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Use a different RPC port per region if accessing several dashboards at once.
RPC_PORT=18480
# Optional restricted website listener, accessed only by an HTTPS reverse proxy.
# PUBLIC_WEB_PORT=18483
P2P_PORT=18481
# P2P binds 0.0.0.0, which needs a genesis calibrated with init --hashrate.
# true runs a genesis with an easier proof-of-work limit anyway, with a warning.
# ALLOW_EASY_TARGET=false
STRATUM_PORT=18482
# true exposes this node's solo mining listener; false validates/relays only.
# false requires no Stratum password file and does not bind STRATUM_PORT.
STRATUM_ENABLED=true
STRATUM_ADVERTISE=mining-a.example.com:18482
# Optional: your miners' addresses or prefixes, which always keep reserved Stratum slots.
# STRATUM_TRUSTED=198.51.100.0/24 2001:db8:10::/48
# Reporting difficulty only; network difficulty comes from the shared genesis/state.
SHARE_DIFFICULTY=65536
# Literal IPv4 endpoints; replace these documentation addresses before installation.
PEERS=198.51.100.20:18481 203.0.113.30:18481
# Recommended for a fixed operator-managed network. Generate a separate
# peer-keygen identity for EACH node; never use wallet/faucet/mining keys.
# Each peer endpoint above must have its own trusted public-key pin below.
# PEER_KEY_FILE=/etc/hashstash/peer-identity.json
# PEER_PINS=198.51.100.20:18481=PEER_B_PUBLIC_KEY 203.0.113.30:18481=PEER_C_PUBLIC_KEY

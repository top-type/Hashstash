[Unit]
Description=Hashstash optional trusted mixer
After=network-online.target hashstash.service
Wants=network-online.target

[Service]
Type=simple
User=hashstash-mixer
Group=hashstash-mixer
UMask=0077
ExecStart=/usr/local/libexec/hashstash/hashstash-mixer run --config /etc/hashstash-mixer/config.json --execute
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/hashstash-mixer /var/lib/hashstash-mixer-status
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitNOFILE=256

[Install]
WantedBy=multi-user.target

[Unit]
Description=Hashstash validating node (optional solo Stratum)
Wants=network-online.target
After=network-online.target
# Never stop retrying: a crash that a peer can repeat must not leave the unit
# permanently stopped. Watch the journal for restart loops.
StartLimitIntervalSec=0

[Service]
Type=simple
User=hashstash
Group=hashstash
WorkingDirectory=/var/lib/hashstash
ExecStart=/usr/local/libexec/hashstash/run-node.sh run
# The node exits with status 70 when a panic poisoned its shared state or
# stopped a long-lived service loop, so a restart revalidates history from
# disk instead of leaving a stuck process.
Restart=on-failure
RestartSec=10
# The node handles Ctrl+C/SIGINT for a graceful listener shutdown.
KillSignal=SIGINT
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/hashstash
CapabilityBoundingSet=
MemoryHigh=512M
MemoryMax=1G
# These are operator resource limits, not proof that every valid chain fits.
# Monitor pressure/OOM restarts and raise them for measured legitimate demand.
TasksMax=128
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Containment after a memory-safety bug in a native dependency (bundled SQLite,
# secp256k1). Unlisted system calls fail with EPERM instead of killing the node.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=true
RemoveIPC=true
# Crash dumps could copy the peer identity or Stratum password.
LimitCORE=0
SyslogIdentifier=hashstash

[Install]
WantedBy=multi-user.target
